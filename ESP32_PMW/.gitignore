# PlatformIO / build
.pio
.pio-core/
build/

# Python tooling
.venv/
__pycache__/

# IDE
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# macOS
.DS_Store

# Stray serial/run logs at repo root
/*.log

# Stale ESP-IDF build artifacts (this is a PlatformIO/Arduino project)
managed_components/
sdkconfig.*
dependencies.lock

# Run artefacts that land in the CWD. `RunConfig.log` defaults to hover_run.log there,
# and simulate_hover writes its figures beside itself, so these reappear every session.
hover_run.log
hover_link_check.log
hover_sim_*.png

# The coil-thermal stamp: per-machine state, never shared.
ai/thermal/.last_energised

*.egg-info/

# Flight recordings: 628 MB of mp4 and counting, one dir per take. Kept on disk, out of
# git. `results/README.md` says what a run dir holds.
results/flights/

# NOT ignored, deliberately: `ai/`, `data/` and `results/`. `main` carried rules for all
# three ("intentionally kept out of main" while the work lived on a branch), and they were
# dropped on 2026-09-27 because they cost us twice in one day: `ai/alignment_rate.py` was
# never committed, so a fresh clone could RECORD but not ANALYSE, and the rim sweep driver
# existed on one machine only. The bulk that actually needed excluding is excluded
# specifically above -- `results/flights/` for the video, `.venv/` and `__pycache__/` for
# the caches -- so what these trees add is code, scripts and small result CSVs.
